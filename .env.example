# Public Cloudflare Worker API origin. This is the default used by the app.
VITE_API_URL=https://famly-pluse-api.fszazo5.workers.dev

# Public Turnstile Site Key, used by web and Android. Not a secret.
VITE_TURNSTILE_SITE_KEY=

# Optional: direct MP4/WebM URL shown in the in-app Help Center
VITE_HELP_VIDEO_URL=

# Keep AUTH0_CLIENT_SECRET and TURNSTILE_SECRET_KEY out of this file.
# Configure them as Cloudflare Worker secrets; see the backend repository README.
