# Public API origin for native/Android builds. Leave empty for same-origin web deployments.
VITE_API_URL=

# Public Cloudflare Turnstile site key used only by native app builds.
VITE_TURNSTILE_SITE_KEY=

# Optional: direct MP4/WebM URL shown in the in-app Help Center
VITE_HELP_VIDEO_URL=

# Optional GitHub repository override for Capacitor OTA frontend bundles.
VITE_OTA_REPOSITORY=fszazo5-design/famly-pluse

# Server-side only (Vercel functions); never use the VITE_ prefix for secrets.
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_REDIRECT_URI=https://famlypulse.vercel.app/
# TURNSTILE_SECRET_KEY=
# Neon integration supplies DATABASE_URL. NEON_DATABASE_URL is also accepted.
# DATABASE_URL=
# NEON_DATABASE_URL=
