# Public Cloudflare Turnstile site key used only by native app builds.
VITE_TURNSTILE_SITE_KEY=

# Firebase Web app configuration (public values; never put service-account secrets here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: direct MP4/WebM URL shown in the in-app Help Center
VITE_HELP_VIDEO_URL=

# Optional GitHub repository override for Capacitor OTA frontend bundles.
VITE_OTA_REPOSITORY=fszazo5-design/famly-pluse

# Server-side only; never use the VITE_ prefix for secrets.
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_REDIRECT_URI=https://famly-pluse-api.fszazo5.workers.dev/
# TURNSTILE_SECRET_KEY=
# Neon integration supplies DATABASE_URL. NEON_DATABASE_URL is also accepted.
# DATABASE_URL=
# NEON_DATABASE_URL=
